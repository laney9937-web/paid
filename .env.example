# Local / PROVIDER_AGNOSTIC defaults. Never commit real secrets.
NODE_ENV=development
PAID_ENV=local
PAID_BUILD_MODE=PROVIDER_AGNOSTIC
PAID_LOG_LEVEL=info

DATABASE_URL=postgres://paid:paid_local_only@127.0.0.1:5432/paid
DATABASE_URL_OPS=postgres://paid:paid_local_only@127.0.0.1:5432/paid

WEB_ORIGIN=http://localhost:3000
OPS_ORIGIN=http://localhost:3001
WEB_PORT=3000
OPS_PORT=3001
WORKER_CONCURRENCY=4

BETTER_AUTH_SECRET=local-dev-better-auth-secret-32b-min!!
BETTER_AUTH_URL=http://localhost:3000
PASSKEY_RP_ID=localhost
PASSKEY_RP_NAME=Paid
PASSKEY_ORIGIN=http://localhost:3000
OPS_PASSKEY_RP_ID=localhost
OPS_PASSKEY_ORIGIN=http://localhost:3001

TOKEN_HMAC_KEY_V1=local-dev-token-hmac-key-v1-32bytes-min
TOKEN_HMAC_PREVIOUS_KEY=
TOKEN_HMAC_CURRENT_VERSION=v1

PROVIDER_MODE=mock
PAYMENTS_ACCEPTANCE=mock
SIMULATOR_ENABLED=true
CHECKOUT_ENABLED=true
PAYOUT_ENABLED=true
ADULT_LANE_ENABLED=false
REVIEW_ENABLED=true
NEW_LINKS_ENABLED=true

JURISDICTION_ALLOWLIST=US
LIVE_JURISDICTION_ALLOWLIST=
POLICY_VERSION=policy.v1.mock
FEE_SCHEDULE_VERSION=fee.v1.mock
BUYER_PROTECTION_POLICY_VERSION=protection.v1.mock
DESCRIPTOR_VERSION=descriptor.v1.mock
TRUST_ALGORITHM_VERSION=trust.v1
RISK_RULES_VERSION=risk.v1.mock
COMPLIANCE_POLICY_VERSION=compliance.v1.mock

RESTRICTED_FIELD_KEY=local-dev-restricted-field-key-32b
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=paid

# Production-only; empty in local
PROVIDER_WEBHOOK_SECRET_CURRENT=
PROVIDER_WEBHOOK_SECRET_PREVIOUS=
MERCHANT_PORTFOLIO_ID=mock-portfolio-usd-digital
