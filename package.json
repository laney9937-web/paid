{
  "name": "paid",
  "private": true,
  "version": "0.1.0",
  "description": "Paid — trust-first creator transaction platform (PROVIDER_AGNOSTIC V1)",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=10.15.0"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @paid/web --filter @paid/ops --filter @paid/worker dev",
    "dev:web": "pnpm --filter @paid/web dev",
    "dev:ops": "pnpm --filter @paid/ops dev",
    "dev:worker": "pnpm --filter @paid/worker dev",
    "build": "pnpm --filter @paid/web build && pnpm --filter @paid/ops build && pnpm --filter @paid/worker build",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @paid/db migrate",
    "db:seed": "pnpm --filter @paid/db seed",
    "db:reset": "pnpm --filter @paid/db reset",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --pretty false --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:property": "vitest run --config vitest.property.config.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:migrations": "vitest run --config vitest.migrations.config.ts",
    "test:security": "vitest run --config vitest.security.config.ts",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/core-pages.spec.ts",
    "test:visual": "pnpm --filter @paid/web exec playwright test --project=visual",
    "test:load": "tsx scripts/load-smoke.mjs",
    "mock:scenario": "pnpm --filter @paid/provider-simulator mock:scenario",
    "sbom": "node scripts/sbom.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@paid/audit": "workspace:*",
    "@paid/auth": "workspace:*",
    "@paid/authorization": "workspace:*",
    "@paid/compliance": "workspace:*",
    "@paid/config": "workspace:*",
    "@paid/contracts": "workspace:*",
    "@paid/db": "workspace:*",
    "@paid/domain": "workspace:*",
    "@paid/email-core": "workspace:*",
    "@paid/email-mock": "workspace:*",
    "@paid/identity-core": "workspace:*",
    "@paid/identity-mock": "workspace:*",
    "@paid/ledger": "workspace:*",
    "@paid/observability": "workspace:*",
    "@paid/payments-core": "workspace:*",
    "@paid/payments-mock": "workspace:*",
    "@paid/provider-simulator": "workspace:*",
    "@paid/reconciliation": "workspace:*",
    "@paid/risk": "workspace:*",
    "@paid/test-support": "workspace:*",
    "@paid/trust": "workspace:*",
    "@paid/ui": "workspace:*"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "fast-check": "4.9.0",
    "prettier": "3.6.2",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "4.1.11"
  }
}
